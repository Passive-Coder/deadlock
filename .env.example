# Local dashboard only; never expose the control API to the internet.
DEADLOCK_HOST=127.0.0.1
DEADLOCK_PORT=8765
DEADLOCK_DATABASE=sqlite
DEADLOCK_DATA_DIR=.deadlock
# Optional Exasol integration. When selected, errors never fall back silently.
EXASOL_DSN=
EXASOL_USER=
EXASOL_PASSWORD=
EXASOL_SCHEMA=DEADLOCK
# Live mediator: codex, openai, or disabled. Deterministic mode is always labeled.
DEADLOCK_MEDIATOR=codex
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Codex shared-daemon socket. Leave blank for automatic proxy connection.
CODEX_APP_SERVER_SOCKET=
# Colon-separated directories in which managed coding agents may run.
# Defaults to the repository working directory.
DEADLOCK_WORKSPACE_ROOTS=
